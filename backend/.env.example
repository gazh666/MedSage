APP_NAME="Rural AI Doctor"
ENVIRONMENT=production 
DEBUG=False

SECRET_KEY=your-super-secret-production-key-change-me

# --- Database Configuration ---

DATABASE_URL=postgresql+asyncpg://user:password@host:port/database?ssl=require

# --- Google Gemini AI Configuration ---

GOOGLE_API_KEY=your-google-ai-studio-api-key
NCBI_API_KEY=optional-ncbi-api-key-for-higher-rate-limits
OPENFDA_API_KEY=your-openfda-api-key
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-002

# --- OpenAI 兼容 LLM（国内：通义千问/DeepSeek/智谱 GLM）---
# 设 LLM_PROVIDER=openai 后，诊断/分诊/chat 走国内模型，无需翻墙。
LLM_PROVIDER=gemini
LLM_API_KEY=your-dashscope-api-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# --- Lung Sound Model (PyTorch) ---
# 肺部呼吸音模型权重路径（PBRNet checkpoint，相对 backend 目录或绝对路径）
MODEL_LUNG_SOUND_CHECKPOINT_PATH=D:/download/QwenPaw-main/best.pth
# RSC-FTF 训练代码根目录（含 models/ 与 BEATs.py），用于复用模型架构
MODEL_LUNG_SOUND_RSC_ROOT=D:/download/QwenPaw-main/rscwo/RSC-FTF-main

# --- LangChain & Agentic Observability ---

LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=rural-ai-doctor-prod
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"

# --- Security & Auth ---
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

BACKEND_CORS_ORIGINS=["https://rural-ai-doctor.vercel.app","http://localhost:3000"]

# --- Infrastructure & Performance ---

REDIS_URL=redis://:password@your-redis-provider.com:6379
RATE_LIMIT_PER_MINUTE=60

# Sentry for python error tracking
SENTRY_DSN=your-sentry-dsn
# Log level management
LOG_LEVEL=INFO

# --- Vector Database (if using external like Pinecone/Weaviate) ---
# VECTOR_DB_API_KEY=your-api-key
# VECTOR_DB_ENVIRONMENT=us-east-1